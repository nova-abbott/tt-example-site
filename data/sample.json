  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Short phrase / command",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 6,
  "source_text": "LOCATE MY QUARTERS AND DROP MY BAGS OFF. YES, SIR.",
  "target_text": "－把行李放在我的住处 －是长官",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Short phrase / command",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 7,
  "source_text": "This isn't Germany or occupied France.",
