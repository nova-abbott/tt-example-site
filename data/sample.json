  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Statement",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 4,
  "source_text": "Or just waited until I went down to the boat some Sunday",
  "target_text": "或者等到某个星期天",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Statement",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 5,
  "source_text": "That's not the same thing.",
