  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Question",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 38,
  "source_text": "I wanted you alive.",
  "target_text": "我不想让你死",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Statement",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 39,
  "source_text": "Please, Roberto, you must be careful, for everyone's sake.",
  "target_text": "求你了 罗伯托 你千万要小心 为了大家",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Statement",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 40,
  "source_text": "BEYOND THAT WHICH IS KNOWN TO MAN.",
  "target_text": "超乎人类认知",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Short phrase / command",
  "human_checked": "no",
  "year": null
 },
 {
  "id": 41,
  "source_text": "Because it's what people buy.",
