  "source_text": "Now, don't take too much of my money away.",
  "target_text": "不要把我的钱带走了太多",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Short phrase / command",
  "human_checked": "no",
  "year": null
 },
 {
