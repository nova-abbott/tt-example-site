  "source_text": "I'd like to stay here and help out.",
  "target_text": "我想留在这帮帮忙",
  "source": "OpenSubtitles v2024 (en-zh_CN), via ~/projects/OpenSubtitles (sample)",
  "category": "Statement",
  "human_checked": "no",
  "year": null
 },
 {
